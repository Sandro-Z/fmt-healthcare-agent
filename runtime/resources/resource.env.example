# Root containing runtime/envs, databases and pipeline output.
WGS_FMT_RESOURCE_ROOT=/srv/wgs-fmt
FMT_ROOT=/srv/wgs-fmt
ENV_ROOT=/srv/wgs-fmt/runtime/envs
DB_ROOT=/srv/wgs-fmt/databases

# Application-owned writable state.
WGS_WORKSPACE=/srv/wgs-fmt/workspace
WGS_UPLOAD_ROOT=/srv/wgs-fmt/workspace/uploads
WGS_UPLOAD_JOB_ROOT=/srv/wgs-fmt/workspace/upload-jobs
WGS_BIOINFORMATICS_OUTPUT_ROOT=/srv/wgs-fmt/postfmt_processed
WGS_FMT_TRIPLET_MODEL_DIR=/srv/wgs-fmt/models/fmt-triplet-v1
WGS_FMT_BASELINE_SPECIES=/srv/wgs-fmt/data/fmt-matching/species_abundance_train.csv
WGS_FMT_MATCH_FILE=/srv/wgs-fmt/data/fmt-matching/match.xlsx

# Optional override. Normally omit this: the application uses its bundled worker.
# WGS_BIOINFORMATICS_WORKER=/opt/fmt-healthcare-agent/runtime/scripts/postfmt_pipeline/process_postfmt_sample.sh
